#!/usr/bin/env bash
# Low-level primitive: build the image and (re)place the container, unconditionally.
# Prefer `privacy-filter-service ensure`, which checks health first and holds a
# lock -- this script's `podman run --replace` will kill a scan that is in flight.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
BACKEND="${PRIVACY_FILTER_BACKEND:-torch}"
case "$BACKEND" in
  torch|onnx) ;;
  *)
    echo "ERROR: PRIVACY_FILTER_BACKEND must be 'torch' or 'onnx', got '$BACKEND'." >&2
    exit 1
    ;;
esac
ONNX_PROVIDER="${PRIVACY_FILTER_ONNX_PROVIDER:-auto}"
case "$ONNX_PROVIDER" in
  auto|cpu|cuda) ;;
  *)
    echo "ERROR: PRIVACY_FILTER_ONNX_PROVIDER must be 'auto', 'cpu' or 'cuda', got '$ONNX_PROVIDER'." >&2
    exit 1
    ;;
esac
if [ "$BACKEND" = "onnx" ] \
   && [ "$ONNX_PROVIDER" = "cuda" ] \
   && ! command -v nvidia-smi >/dev/null 2>&1; then
  echo "ERROR: PRIVACY_FILTER_ONNX_PROVIDER=cuda, but nvidia-smi is unavailable." >&2
  exit 1
fi
DEFAULT_TAG="gpu"
if [ "$BACKEND" = "onnx" ]; then
  DEFAULT_TAG="onnx"
fi
IMAGE="${PRIVACY_FILTER_IMAGE:-localhost/privacy-filter-local:${DEFAULT_TAG}}"
CONTAINER="${PRIVACY_FILTER_CONTAINER:-privacy-filter-local}"
PORT="${PRIVACY_FILTER_PORT:-8757}"
# Probe once on a cold start. A running container owns VRAM that --replace will
# release, so measuring while it exists would choose an artificially small
# window. `privacy-filter-service restart` stops it before reaching this script.
free_mib=""
if command -v nvidia-smi >/dev/null 2>&1 \
   && ! podman ps --filter "name=^${CONTAINER}$" --format '{{.Names}}' | grep -q .; then
  free_mib=$(nvidia-smi --query-gpu=memory.free --format=csv,noheader,nounits | head -1 | tr -dc '0-9')
fi

# The torch model needs ~2.8GB bf16 weights plus the CUDA context and transient
# per-request memory. Refuse to start below this so a VRAM-starved GPU fails
# before loading the checkpoint.
MIN_FREE_VRAM_MIB="${PRIVACY_FILTER_MIN_FREE_VRAM_MIB:-3000}"
if [ "$BACKEND" = "torch" ] && [ -n "$free_mib" ]; then
  if [ "$free_mib" -lt "$MIN_FREE_VRAM_MIB" ]; then
    echo "ERROR: only ${free_mib} MiB GPU memory free, need >= ${MIN_FREE_VRAM_MIB} MiB to start the Privacy Filter." >&2
    echo "Close VRAM-heavy apps (e.g. a game), or override with PRIVACY_FILTER_MIN_FREE_VRAM_MIB=<mib>." >&2
    exit 1
  fi
  echo "GPU memory free: ${free_mib} MiB (need >= ${MIN_FREE_VRAM_MIB})"
fi

# ONNX CUDA can start small. Pick the largest window whose measured peak leaves
# roughly 0.75 GiB of headroom on the RTX 3080; per-request adaptive shrinking
# remains the authority if availability changes after startup. An operator-set
# maximum always wins.
if [ "$BACKEND" = "onnx" ] \
   && [ "$ONNX_PROVIDER" != "cpu" ] \
   && [ -n "$free_mib" ] \
   && [ -z "${PRIVACY_FILTER_MAX_TOKENS:-}" ]; then
  if [ "$free_mib" -ge 6144 ]; then
    PRIVACY_FILTER_MAX_TOKENS=4096
  elif [ "$free_mib" -ge 3072 ]; then
    PRIVACY_FILTER_MAX_TOKENS=2048
  elif [ "$free_mib" -ge 1536 ]; then
    PRIVACY_FILTER_MAX_TOKENS=1024
  else
    PRIVACY_FILTER_MAX_TOKENS=256
  fi
  echo "GPU memory free: ${free_mib} MiB; selecting ${PRIVACY_FILTER_MAX_TOKENS} tokens for ONNX"
fi

mkdir -p "$ROOT/cache"

# Forward the inference-budget knobs into the container, but only the ones that
# are actually set: an empty --env would override the service's own defaults with
# an empty string, which parses as an error rather than as "use the default".
env_args=()
for name in PRIVACY_FILTER_MAX_TOKENS PRIVACY_FILTER_MIN_TOKENS \
            PRIVACY_FILTER_TOKEN_SHRINK_FACTOR PRIVACY_FILTER_CHUNK_OVERLAP_TOKENS \
            PRIVACY_FILTER_CONTEXT_LIMIT PRIVACY_FILTER_MODEL PRIVACY_FILTER_ONNX_FILE; do
  if [ -n "${!name:-}" ]; then
    env_args+=(--env "${name}=${!name}")
    echo "Passing ${name}=${!name} to the service"
  fi
done
env_args+=(--env "PRIVACY_FILTER_BACKEND=${BACKEND}")
if [ "$BACKEND" = "onnx" ]; then
  env_args+=(--env "PRIVACY_FILTER_ONNX_PROVIDER=${ONNX_PROVIDER}")
fi

device_args=()
if [ "$BACKEND" = "torch" ]; then
  device_args+=(--device nvidia.com/gpu=all)
elif [ "$ONNX_PROVIDER" != "cpu" ] && command -v nvidia-smi >/dev/null 2>&1; then
  # auto uses CUDA when a device is present and CPU elsewhere.
  device_args+=(--device nvidia.com/gpu=all)
fi

# -q: the build is a cache hit on all but the first run, and the hook runs this
# on every commit. Failures still print to stderr.
podman build -q \
  --build-arg "PRIVACY_FILTER_BACKEND=${BACKEND}" \
  -t "$IMAGE" -f "$ROOT/Containerfile" "$ROOT" >/dev/null
podman run \
  --detach \
  --replace \
  --name "$CONTAINER" \
  --security-opt=label=disable \
  "${device_args[@]}" \
  --publish "127.0.0.1:${PORT}:8757" \
  --volume "$ROOT/cache:/cache:rw" \
  "${env_args[@]}" \
  "$IMAGE"

echo "Privacy Filter service starting on http://127.0.0.1:${PORT}"
echo "Check readiness with: $ROOT/privacy-filter health"
